# ==============================================================================
# pfELK Docker Environment
# Version: 26.10.1
#
# Copy this file to .env with:
#   ./etc/pfelk/scripts/pfelk-docker-init.sh
#
# NEVER commit the generated .env file.
# ==============================================================================

# Elastic Stack
STACK_VERSION=9.5.4
CLUSTER_NAME=pfelk
LICENSE=basic

# Secrets are generated by pfelk-docker-init.sh.
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
PFELK_ES_PASSWORD=

# Dedicated runtime writer created by the setup service.
PFELK_ES_USER=pfelk_writer

# pfELK data-stream settings.
PFELK_NAMESPACE=default
PFELK_TIMEZONE=UTC
PFELK_RETENTION=30d
PFELK_ERROR_RETENTION=14d
PFELK_REPLICAS=0

# Elasticsearch host exposure. Keep Elasticsearch loopback-only unless there is
# a specific operational reason to expose it beyond the Docker host.
ES_BIND=127.0.0.1
ES_PORT=9200

# Kibana browser endpoint. Docker enables TLS by default and generates a
# certificate for localhost, kibana, and KIBANA_SERVER_NAME.
KIBANA_BIND=0.0.0.0
KIBANA_PORT=5601
KIBANA_SERVER_NAME=pfelk.local

# Syslog listener. Prefer a specific LAN/firewall-facing host address on
# multi-homed systems.
SYSLOG_BIND=0.0.0.0
SYSLOG_PORT=5140

# Container memory limits.
ES_MEM_LIMIT=4g
KB_MEM_LIMIT=1g
LS_MEM_LIMIT=2g

# JVM heap. Keep Xms/Xmx equal and normally <= 50% of the container limit.
ES_JAVA_OPTS=-Xms2g -Xmx2g
LS_JAVA_OPTS=-Xms1g -Xmx1g

# Logstash durability.
PFELK_QUEUE_SIZE=2gb
PFELK_DLQ_SIZE=1gb
PFELK_DLQ_RETAIN=14d
