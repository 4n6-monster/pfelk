# ==============================================================================
# pfELK Docker Environment
# Version: 26.10
#
# IMPORTANT:
# - DO NOT commit this file to Git.
# - Keep permissions restricted:
#       chmod 600 .env
# - Generate unique strong passwords for all credential fields below.
# ==============================================================================


# ------------------------------------------------------------------------------
# Elastic Stack
# ------------------------------------------------------------------------------

# Elastic Stack version used by Elasticsearch, Kibana, and Logstash.
STACK_VERSION=9.5.4

# Elasticsearch cluster name.
CLUSTER_NAME=pfelk

# Elastic license type.
LICENSE=basic


# ------------------------------------------------------------------------------
# Credentials
# ------------------------------------------------------------------------------

# Elasticsearch administrative/bootstrap account.
#
# Used by the one-time Docker setup container to configure security,
# kibana_system, and the dedicated pfelk_writer account.
#
# DO NOT use this account for normal Logstash ingestion.
ELASTIC_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SECRET


# Kibana backend service account password.
#
# The setup container assigns this password to the built-in:
#
#   kibana_system
#
# Kibana then uses that account to communicate with Elasticsearch.
KIBANA_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SECRET


# Dedicated pfELK Logstash writer account.
#
# The Docker setup creates:
#
#   user: pfelk_writer
#
# This account is restricted to pfELK data streams instead of using the
# Elasticsearch elastic superuser.
PFELK_ES_USER=pfelk_writer
PFELK_ES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SECRET


# ------------------------------------------------------------------------------
# pfELK Data Stream Configuration
# ------------------------------------------------------------------------------

# ECS data stream namespace.
#
# Examples:
#
#   default
#   home
#   lab
#   production
#   site1
#
# Resulting data streams include:
#
#   logs-pfelk.firewall-default
#   logs-pfelk.unbound-default
#   logs-pfelk.openvpn-default
#   logs-pfelk.suricata-default
#   logs-pfelk.pipeline_error-default
PFELK_NAMESPACE=default


# Timezone used when parsing RFC3164 syslog records.
#
# RFC3164 timestamps do not contain a timezone or UTC offset, so this should
# match the timezone configured on your pfSense/OPNsense firewall.
#
# Examples:
#
#   America/Chicago
#   America/New_York
#   America/Denver
#   America/Los_Angeles
#   UTC
PFELK_TIMEZONE=America/Chicago


# ------------------------------------------------------------------------------
# Elasticsearch Network Configuration
# ------------------------------------------------------------------------------

# Bind Elasticsearch to localhost only.
#
# This is recommended because Kibana and Logstash communicate with
# Elasticsearch over the internal Docker network.
#
# There is normally no reason to expose Elasticsearch directly to your LAN.
ES_BIND=127.0.0.1

# Host-side Elasticsearch port.
ES_PORT=9200


# ------------------------------------------------------------------------------
# Kibana Network Configuration
# ------------------------------------------------------------------------------

# Kibana bind address.
#
# 0.0.0.0 allows access through any host network interface.
#
# For a more restricted installation, replace this with the pfELK server's
# management/LAN IP address.
#
# Example:
#
#   KIBANA_BIND=192.168.1.50
KIBANA_BIND=0.0.0.0

# Kibana web interface port.
KIBANA_PORT=5601


# ------------------------------------------------------------------------------
# Syslog Listener Configuration
# ------------------------------------------------------------------------------

# Address used for incoming pfSense / OPNsense syslog traffic.
#
# 0.0.0.0 listens on all interfaces.
#
# For a multi-interface server, consider setting this to the LAN interface
# that should receive firewall logs.
#
# Example:
#
#   SYSLOG_BIND=192.168.1.50
SYSLOG_BIND=0.0.0.0

# pfELK syslog listener port.
#
# Both TCP and UDP are exposed by docker-compose.yml.
SYSLOG_PORT=5140


# ------------------------------------------------------------------------------
# Docker Container Memory Limits
# ------------------------------------------------------------------------------

# Elasticsearch container memory ceiling.
#
# Recommended starting value:
#   4 GB
#
# Increase for higher event volumes and longer retention workloads.
ES_MEM_LIMIT=4g


# Kibana container memory ceiling.
KB_MEM_LIMIT=1g


# Logstash container memory ceiling.
#
# 2 GB is a reasonable starting point for typical pfELK installations.
LS_MEM_LIMIT=2g


# ------------------------------------------------------------------------------
# JVM Heap Configuration
# ------------------------------------------------------------------------------

# Elasticsearch JVM heap.
#
# Keep Xms and Xmx equal.
#
# This configuration gives Elasticsearch a 2 GB heap inside a 4 GB container.
ES_JAVA_OPTS=-Xms2g -Xmx2g


# Logstash JVM heap.
#
# This gives Logstash a 1 GB heap inside a 2 GB container.
LS_JAVA_OPTS=-Xms1g -Xmx1g


# ------------------------------------------------------------------------------
# Logstash Persistent Queue
# ------------------------------------------------------------------------------

# Maximum size of the Logstash persistent queue.
#
# The persistent queue protects events when Elasticsearch is temporarily
# unavailable or cannot accept events fast enough.
#
# Increase this value if the pfELK server receives high-volume traffic and has
# sufficient disk space.
PFELK_QUEUE_SIZE=2gb


# ------------------------------------------------------------------------------
# Logstash Dead Letter Queue
# ------------------------------------------------------------------------------

# Maximum size of the Logstash dead-letter queue.
#
# The DLQ stores supported events that Elasticsearch rejects because of issues
# such as mapping conflicts or indexing errors.
PFELK_DLQ_SIZE=1gb
