# 35-rules-desc.pfelk
################################################################################
# Version: 26.10.1                                                               #
# Required: False - Optional                                                   #
# Description: Resolves firewall rule IDs through rule-names.csv.               #
################################################################################

filter {
  if "firewall" in [tags] and [rule][id] {
    translate {
      id => "pfelk-firewall-rule-name"
      source => "[rule][id]"
      target => "[rule][name]"
      dictionary_path => "/etc/pfelk/databases/rule-names.csv"
      refresh_interval => 60
      refresh_behaviour => replace
      fallback => "%{[rule][id]}"
    }

    if [interface][alias] and [rule][name] {
      mutate {
        add_field => {
          "[rule][description]" => "%{[interface][alias]}: %{[rule][name]}"
        }
      }
    } else if [rule][name] {
      mutate {
        copy => {
          "[rule][name]" => "[rule][description]"
        }
      }
    }
  }
}
