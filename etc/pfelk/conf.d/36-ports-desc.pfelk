# 36-ports-desc.pfelk
################################################################################
# Version: 26.10.1                                                               #
# Required: False - Optional                                                   #
# Description: Maps a service port to network.application.                      #
#                                                                              #
# IMPORTANT: service-names-port-numbers.csv is keyed by PORT, not by the IP    #
# protocol/IANA number. The legacy file incorrectly used network.iana_number.   #
################################################################################

filter {
  if "firewall" in [tags] {
    if [destination][port] {
      translate {
        id => "pfelk-destination-service"
        source => "[destination][port]"
        target => "[network][application]"
        dictionary_path => "/etc/pfelk/databases/service-names-port-numbers.csv"
        refresh_interval => 300
        refresh_behaviour => replace
      }
    } else if [source][port] {
      # Useful for response traffic when no destination port was parsed.
      translate {
        id => "pfelk-source-service-fallback"
        source => "[source][port]"
        target => "[network][application]"
        dictionary_path => "/etc/pfelk/databases/service-names-port-numbers.csv"
        refresh_interval => 300
        refresh_behaviour => replace
      }
    }
  }
}
