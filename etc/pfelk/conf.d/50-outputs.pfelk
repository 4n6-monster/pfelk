# 50-outputs.pfelk
################################################################################
# Version: 26.10.1                                                             #
# Required: True                                                               #
# Description: Builds ECS data-stream routing fields and sends events to       #
#              Elasticsearch.                                                  #
#                                                                              #
# Required environment/keystore value: PFELK_ES_PASSWORD                       #
# Optional: PFELK_ES_HOSTS, PFELK_ES_USER, PFELK_CA_PATH, PFELK_NAMESPACE     #
################################################################################

filter {
  # Every parser that cannot fully normalize an event adds this generic tag.
  # Specific _pfelk_* tags remain on the event for root-cause analysis.
  if "pfelk_pipeline_error" in [tags] {
    mutate {
      replace => {
        "[event][dataset]" => "pfelk.pipeline_error"
        "[event][kind]" => "pipeline_error"
      }
    }
  }

  # Every pfELK event should carry a dataset. Unknown/unparsed processes are kept
  # rather than silently discarded so new/changed upstream formats are visible.
  if ![event][module] {
    mutate { add_field => { "[event][module]" => "pfelk" } }
  }

  if ![event][dataset] {
    mutate { add_field => { "[event][dataset]" => "pfelk.unknown" } }
  }

  # ECS data streams are <type>-<dataset>-<namespace>.
  mutate {
    add_field => {
      "[data_stream][type]" => "logs"
      "[data_stream][namespace]" => "${PFELK_NAMESPACE:default}"
    }
    copy => {
      "[event][dataset]" => "[data_stream][dataset]"
    }
  }
}

output {
  # CI fixture tests add this metadata field and receive JSON on stdout without
  # attempting to contact Elasticsearch.
  if [@metadata][pfelk_test] {
    stdout { codec => json_lines }
  } else {
    elasticsearch {
      id => "pfelk-elasticsearch"

      data_stream => "true"
      data_stream_auto_routing => true
      data_stream_sync_fields => true

      # Templates/lifecycle are installed by the native installer or Docker
      # setup service. The runtime writer therefore needs only ingest rights.
      manage_template => false

      hosts => [ "${PFELK_ES_HOSTS:https://localhost:9200}" ]
      user => "${PFELK_ES_USER:pfelk_writer}"
      password => "${PFELK_ES_PASSWORD}"

      ssl_enabled => true
      ssl_certificate_authorities => [
        "${PFELK_CA_PATH:/etc/logstash/config/certs/http_ca.crt}"
      ]
      ssl_verification_mode => "full"
    }
  }
}
