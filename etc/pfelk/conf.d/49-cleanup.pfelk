# 49-cleanup.pfelk
################################################################################
# Version: 26.10                                                               #
# Required: False - Recommended                                                #
# Description: Removes parser working fields and normalizes multi-value fields. #
################################################################################

filter {
  ### Optional priority-based dropping ##########################################
  # if [log][syslog][priority] in [78, 46, 45, 43] {
  #   drop { }
  # }

  ### Normalize multi-value fields #############################################
  if [pf][tcp][options] and [pf][tcp][options] != "" {
    mutate {
      split => { "[pf][tcp][options]" => ";" }
    }
  }

  if [openvpn][client][sso] and [openvpn][client][sso] != "" {
    mutate {
      split => { "[openvpn][client][sso]" => "," }
    }
  }

  if [openvpn][client][ciphers] and [openvpn][client][ciphers] != "" {
    mutate {
      split => { "[openvpn][client][ciphers]" => ":" }
    }
  }

  ### Normalize pf TCP sequence ranges without invoking Ruby for every event ####
  if [pf][tcp][sequence_number] =~ /:/ {
    dissect {
      mapping => {
        "[pf][tcp][sequence_number]" => "%{[pf][tcp][sequence_number_start]}:%{[pf][tcp][sequence_number_range_end]}"
      }
      tag_on_failure => [ "_pfelk_tcp_sequence_parse_failure" ]
    }

    if [pf][tcp][sequence_number_start] {
      mutate {
        remove_field => [ "[pf][tcp][sequence_number]" ]
        rename => {
          "[pf][tcp][sequence_number_start]" => "[pf][tcp][sequence_number]"
        }
      }
      mutate {
        convert => {
          "[pf][tcp][sequence_number]" => "integer"
          "[pf][tcp][sequence_number_range_end]" => "integer"
        }
      }
    }
  } else if [pf][tcp][sequence_number] {
    mutate {
      convert => { "[pf][tcp][sequence_number]" => "integer" }
    }
  }

  ### Remove parser working fields #############################################
  # event.original was captured in 01-inputs before parsing, so message can now
  # be safely removed without losing the original evidence.
  mutate {
    remove_field => [
      "message",
      "filter_message",
      "captiveportalmessage",
      "pfelk",
      "pfelk_csv"
    ]
  }
}
