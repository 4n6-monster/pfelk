# 01-inputs.pfelk
################################################################################
# Version: 26.10.1                                                               #
# Required: True                                                               #
# Description: Receives pfELK syslog, preserves the original event, parses PRI, #
#              and normalizes the device timestamp into @timestamp.             #
################################################################################

input {
  # Use discrete UDP/TCP inputs instead of the syslog input plugin. pfELK owns
  # the downstream RFC3164/RFC5424 parsing, and this avoids duplicate syslog
  # timestamp parsing and the previous ECS v1 override.
  udp {
    id => "pfelk-syslog-udp"
    port => 5140
    tags => [ "pfelk" ]
  }

  tcp {
    id => "pfelk-syslog-tcp"
    port => 5140
    tags => [ "pfelk" ]

    # Optional TLS example:
    # ssl_enabled => true
    # ssl_certificate_authorities => ["/etc/logstash/ssl/YOURCAHERE.crt"]
    # ssl_certificate => "/etc/logstash/ssl/SERVER.crt"
    # ssl_key => "/etc/logstash/ssl/SERVER.key"
    # ssl_client_authentication => "required"
  }
}

filter {
  if "pfelk" in [tags] {
    # Preserve the exact received record before any parser modifies message.
    # event.created records when Logstash first created the event; @timestamp is
    # subsequently replaced with the timestamp generated by the firewall.
    mutate {
      copy => {
        "message" => "[event][original]"
        "@timestamp" => "[event][created]"
      }
    }

    # Remove the RFC syslog PRI from the message while retaining the numeric PRI.
    grok {
      id => "pfelk-syslog-priority"
      match => {
        "message" => "^<%{POSINT:[log][syslog][priority]:int}>%{GREEDYDATA:[@metadata][pfelk_message]}$"
      }
      tag_on_failure => [ "pfelk_pipeline_error", "_pfelk_syslog_priority_failure" ]
    }

    # Derive ECS syslog facility/severity fields from the captured PRI.
    if [log][syslog][priority] {
      syslog_pri {
        id => "pfelk-syslog-pri-enrichment"
        ecs_compatibility => "v8"
        syslog_pri_field_name => "[log][syslog][priority]"
      }
    }

    # Parse the pfSense/OPNsense RFC3164 or RFC5424 header.
    if [@metadata][pfelk_message] {
      grok {
        id => "pfelk-syslog-header"
        patterns_dir => [ "/etc/pfelk/patterns" ]
        match => {
          "[@metadata][pfelk_message]" => "%{PFELK}"
        }
        tag_on_failure => [ "pfelk_pipeline_error", "_pfelk_header_parse_failure" ]
      }
    }

    # Device time is the event time. PFELK_TIMEZONE is important for RFC3164
    # messages because they do not contain an explicit timezone.
    if [pfelk][timestamp] {
      # RFC3164 timestamps have no timezone. Preserve the configured source
      # timezone explicitly in ECS; ISO8601/RFC5424 timestamps already carry
      # timezone/offset information.
      if [pfelk][timestamp] =~ /^[A-Z][a-z]{2}[ ]/ {
        mutate {
          add_field => { "[event][timezone]" => "${PFELK_TIMEZONE:UTC}" }
        }
      }

      date {
        id => "pfelk-event-timestamp"
        match => [
          "[pfelk][timestamp]",
          "MMM  d HH:mm:ss",
          "MMM dd HH:mm:ss",
          "ISO8601"
        ]
        target => "@timestamp"
        timezone => "${PFELK_TIMEZONE:UTC}"
        tag_on_failure => [ "pfelk_pipeline_error", "_pfelk_date_parse_failure" ]
      }
    }
  }
}
