# 30-geoip.pfelk
################################################################################
# Version: 26.10                                                               #
# Required: False - Optional                                                   #
# Description: GeoIP/ASN enrichment for ECS source, destination, and client IPs.#
# For MaxMind local databases, remove "#MMR#" from the relevant database lines. #
################################################################################

filter {
  # Addresses below are non-public/reserved and should not be sent to GeoIP.
  # The list includes RFC1918, loopback, link-local, CGNAT, documentation,
  # benchmark, multicast, unspecified, and IPv6 ULA/documentation ranges.

  if [source][ip] {
    cidr {
      id => "pfelk-source-nonpublic"
      address => [ "%{[source][ip]}" ]
      network => [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "198.51.100.0/24",
        "203.0.113.0/24",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "255.255.255.255/32",
        "::/128",
        "::1/128",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8",
        "2001:db8::/32"
      ]
      add_tag => [ "IP_NonPublic_Source" ]
    }

    if "IP_NonPublic_Source" not in [tags] {
      geoip {
        id => "pfelk-source-city"
        source => "[source][ip]"
#MMR#  database => "/usr/share/GeoIP/GeoLite2-City.mmdb"
      }
      geoip {
        id => "pfelk-source-asn"
        source => "[source][ip]"
        default_database_type => "ASN"
#MMR#  database => "/usr/share/GeoIP/GeoLite2-ASN.mmdb"
      }
      mutate {
        add_tag => [ "GeoIP_Source" ]
      }
    }
  }

  if [destination][ip] {
    cidr {
      id => "pfelk-destination-nonpublic"
      address => [ "%{[destination][ip]}" ]
      network => [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "198.51.100.0/24",
        "203.0.113.0/24",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "255.255.255.255/32",
        "::/128",
        "::1/128",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8",
        "2001:db8::/32"
      ]
      add_tag => [ "IP_NonPublic_Destination" ]
    }

    if "IP_NonPublic_Destination" not in [tags] {
      geoip {
        id => "pfelk-destination-city"
        source => "[destination][ip]"
#MMR#  database => "/usr/share/GeoIP/GeoLite2-City.mmdb"
      }
      geoip {
        id => "pfelk-destination-asn"
        source => "[destination][ip]"
        default_database_type => "ASN"
#MMR#  database => "/usr/share/GeoIP/GeoLite2-ASN.mmdb"
      }
      mutate {
        add_tag => [ "GeoIP_Destination" ]
      }
    }
  }

  # Covers HAProxy/nginx and the normalized OpenVPN remote peer.
  if [client][ip] {
    cidr {
      id => "pfelk-client-nonpublic"
      address => [ "%{[client][ip]}" ]
      network => [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "198.51.100.0/24",
        "203.0.113.0/24",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "255.255.255.255/32",
        "::/128",
        "::1/128",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8",
        "2001:db8::/32"
      ]
      add_tag => [ "IP_NonPublic_Client" ]
    }

    if "IP_NonPublic_Client" not in [tags] {
      geoip {
        id => "pfelk-client-city"
        source => "[client][ip]"
#MMR#  database => "/usr/share/GeoIP/GeoLite2-City.mmdb"
      }
      geoip {
        id => "pfelk-client-asn"
        source => "[client][ip]"
        default_database_type => "ASN"
#MMR#  database => "/usr/share/GeoIP/GeoLite2-ASN.mmdb"
      }
      mutate {
        add_tag => [ "GeoIP_Client" ]
      }
    }
  }
}
