# 38-enhanced_url.pfelk
################################################################################
# Version: 26.10                                                               #
# Required: False - Optional                                                   #
# Description: URL normalization/enrichment for url.original.                  #
#                                                                              #
# Credentials embedded in URLs are deliberately NOT extracted into events.     #
################################################################################

filter {
  if [url][original] {
    ruby {
      id => "pfelk-url-enrichment"
      code => '
        require "uri"

        raw = event.get("[url][original]")
        unless raw.nil?
          event.set("[pfelk][url][length]", raw.length)
          event.set("[pfelk][url][path_segments]", [raw.split("/").length - 1, 0].max)
          event.set("[pfelk][url][has_non_ascii]", !raw.ascii_only?)
          event.set("[pfelk][url][has_whitespace]", !!(raw =~ /\s/))

          begin
            parsed = URI.parse(raw)

            event.set("[url][scheme]", parsed.scheme) if event.get("[url][scheme]").nil? && parsed.scheme
            event.set("[url][domain]", parsed.host) if event.get("[url][domain]").nil? && parsed.host
            event.set("[url][port]", parsed.port) if event.get("[url][port]").nil? && parsed.port
            event.set("[url][path]", parsed.path) if event.get("[url][path]").nil? && parsed.path && !parsed.path.empty?
            event.set("[url][query]", parsed.query) if event.get("[url][query]").nil? && parsed.query && !parsed.query.empty?

            extension = File.extname(parsed.path.to_s)
            if event.get("[url][extension]").nil? && extension && !extension.empty?
              event.set("[url][extension]", extension.sub(/^\./, ""))
            end

            # parsed.user / parsed.password are intentionally ignored.
          rescue URI::InvalidURIError, ArgumentError => e
            event.tag("_pfelk_url_parse_failure")
            event.set("[pfelk][url][parse_error]", e.class.to_s)
          end
        end
      '
      tag_on_exception => "_pfelk_url_enrichment_failure"
    }

    if [url][port] {
      mutate {
        convert => { "[url][port]" => "integer" }
      }
    }
  }
}
