# 37-enhanced_user_agent.pfelk
################################################################################
# Version: 26.10.1                                                               #
# Required: False - Optional                                                   #
# Description: ECS user-agent parsing/enrichment.                              #
################################################################################

filter {
  if [user_agent][original] {
    useragent {
      id => "pfelk-user-agent"
      source => "[user_agent][original]"
      target => "[user_agent]"
      ecs_compatibility => "v8"
      tag_on_failure => [ "_pfelk_useragent_parse_failure" ]
    }

    # Keep custom analytics under the pfelk namespace rather than inventing
    # fields beneath ECS user_agent.*
    ruby {
      id => "pfelk-user-agent-length"
      code => '
        value = event.get("[user_agent][original]")
        event.set("[pfelk][user_agent][length]", value.length) if value
      '
      tag_on_exception => "_pfelk_useragent_length_failure"
    }
  }
}
