# 45-enhanced_private.pfelk
################################################################################
# Version: 26.10                                                               #
# Required: False - Optional                                                   #
# Description: Local/private client hostname enrichment.                       #
#                                                                              #
# No fabricated GeoIP location is added. Add organization/location metadata    #
# only when it represents your actual environment.                             #
################################################################################

filter {
  # Normalize application-specific local-client addresses into ECS client.ip.
  if "kea-dhcp" in [tags] and [kea][dhcp][client][ip] and ![client][ip] {
    mutate {
      copy => { "[kea][dhcp][client][ip]" => "[client][ip]" }
    }
  }

  if "dhcp" in [tags] and [dhcpv6][client][ip] and ![client][ip] {
    mutate {
      copy => { "[dhcpv6][client][ip]" => "[client][ip]" }
    }
  }

  if [client][ip] {
    cidr {
      id => "pfelk-private-client"
      address => [ "%{[client][ip]}" ]
      network => [
        "0.0.0.0/8",
        "10.0.0.0/8",
        "100.64.0.0/10",
        "127.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.168.0.0/16",
        "198.18.0.0/15",
        "198.51.100.0/24",
        "203.0.113.0/24",
        "224.0.0.0/4",
        "240.0.0.0/4",
        "::/128",
        "::1/128",
        "fc00::/7",
        "fe80::/10",
        "ff00::/8",
        "2001:db8::/32"
      ]
      add_tag => [ "IP_NonPublic_Client" ]
    }
  }

  if "IP_NonPublic_Client" in [tags] and [client][ip] {
    translate {
      id => "pfelk-private-client-domain"
      source => "[client][ip]"
      target => "[client][domain]"
      dictionary_path => "/etc/pfelk/databases/private-hostnames.csv"
      refresh_interval => 600
      refresh_behaviour => replace
    }

    if [client][domain] {
      mutate {
        lowercase => [ "[client][domain]" ]
      }
    }
  }
}
