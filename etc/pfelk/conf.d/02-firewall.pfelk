# 02-firewall.pfelk
################################################################################
# Version: 26.10.1                                                               #
# Required: True                                                               #
# Description: Parses and enriches pf filterlog events from pfSense/OPNsense.   #
#                                                                              #
# Key changes:                                                                 #
# - network.transport replaces network.protocol for TCP/UDP/ICMP transport.    #
# - network.direction uses perimeter ECS values inbound/outbound.              #
# - packet length is represented as network.bytes, not *.packets.              #
# - network.packets is set to 1 for a single filterlog packet event.           #
# - observer ingress/egress interface fields are populated.                    #
# - common numeric fields are explicitly converted.                            #
################################################################################

filter {
  if [log][syslog][appname] == "filterlog" {
    mutate {
      add_tag => [ "firewall" ]
      add_field => {
        "[event][module]" => "pfelk"
        "[event][dataset]" => "pfelk.firewall"
        "[event][kind]" => "event"
        "[event][category]" => "network"
        "[observer][type]" => "firewall"
      }
      replace => {
        "[log][syslog][appname]" => "firewall"
      }
      copy => {
        "filter_message" => "pfelk_csv"
        "[log][syslog][hostname]" => "[observer][hostname]"
      }
    }

    mutate {
      strip => [ "pfelk_csv" ]
      split => { "pfelk_csv" => "," }
    }

    # Common filterlog fields.
    mutate {
      add_field => {
        "[rule][id]" => "%{[pfelk_csv][0]}"
        "[pf][rule][subid]" => "%{[pfelk_csv][1]}"
        "[pf][anchor]" => "%{[pfelk_csv][2]}"
        "[rule][uuid]" => "%{[pfelk_csv][3]}"
        "[interface][name]" => "%{[pfelk_csv][4]}"
        "[event][reason]" => "%{[pfelk_csv][5]}"
        "[event][action]" => "%{[pfelk_csv][6]}"
        "[network][direction]" => "%{[pfelk_csv][7]}"
        "[network][type]" => "%{[pfelk_csv][8]}"
      }
    }
    mutate {
      lowercase => [ "[event][action]", "[network][direction]" ]
    }

    # ECS firewall disposition. event.action keeps the native pf terminology;
    # event.type provides normalized allow/deny categorization.
    if [event][action] in [ "pass", "allow", "accept" ] {
      mutate {
        add_field => { "[event][type]" => "allowed" }
      }
    } else if [event][action] in [ "block", "deny", "reject", "drop" ] {
      mutate {
        add_field => { "[event][type]" => "denied" }
      }
    }

    # The current filterlog parser supports IPv4/IPv6 packet records. Unknown or
    # truncated records are retained and routed to pfelk.pipeline_error.
    if ![pfelk_csv][8] or [network][type] not in [ "4", "6" ] {
      mutate {
        add_tag => [ "pfelk_pipeline_error", "_pfelk_firewall_parse_failure" ]
      }
    }

    # IPv4
    if [network][type] == "4" {
      mutate {
        add_field => {
          "[pf][tos]" => "%{[pfelk_csv][9]}"
          "[pf][ecn]" => "%{[pfelk_csv][10]}"
          "[pf][ttl]" => "%{[pfelk_csv][11]}"
          "[pf][id]" => "%{[pfelk_csv][12]}"
          "[pf][offset]" => "%{[pfelk_csv][13]}"
          "[pf][flags]" => "%{[pfelk_csv][14]}"
          "[network][iana_number]" => "%{[pfelk_csv][15]}"
          "[network][transport]" => "%{[pfelk_csv][16]}"
          "[pf][packet][length]" => "%{[pfelk_csv][17]}"
          "[source][ip]" => "%{[pfelk_csv][18]}"
          "[destination][ip]" => "%{[pfelk_csv][19]}"
        }
      }
      mutate {
        lowercase => [ "[network][transport]" ]
        convert => {
          "[pf][ttl]" => "integer"
          "[pf][id]" => "integer"
          "[pf][offset]" => "integer"
          "[pf][packet][length]" => "integer"
        }
      }

      if [network][transport] == "tcp" {
        mutate {
          add_field => {
            "[source][port]" => "%{[pfelk_csv][20]}"
            "[destination][port]" => "%{[pfelk_csv][21]}"
            "[pf][data_length]" => "%{[pfelk_csv][22]}"
            "[pf][tcp][flags]" => "%{[pfelk_csv][23]}"
            "[pf][tcp][sequence_number]" => "%{[pfelk_csv][24]}"
            "[pf][tcp][ack]" => "%{[pfelk_csv][25]}"
            "[pf][tcp][window]" => "%{[pfelk_csv][26]}"
            "[pf][tcp][urg]" => "%{[pfelk_csv][27]}"
            "[pf][tcp][options]" => "%{[pfelk_csv][28]}"
          }
        }
        mutate {
          convert => {
            "[source][port]" => "integer"
            "[destination][port]" => "integer"
            "[pf][data_length]" => "integer"
            "[pf][tcp][ack]" => "integer"
            "[pf][tcp][window]" => "integer"
            "[pf][tcp][urg]" => "integer"
          }
        }
      } else if [network][transport] == "udp" {
        mutate {
          add_field => {
            "[source][port]" => "%{[pfelk_csv][20]}"
            "[destination][port]" => "%{[pfelk_csv][21]}"
            "[pf][data_length]" => "%{[pfelk_csv][22]}"
          }
        }
        mutate {
          convert => {
            "[source][port]" => "integer"
            "[destination][port]" => "integer"
            "[pf][data_length]" => "integer"
          }
        }
      } else if [network][transport] == "icmp" {
        mutate {
          add_field => { "[pf][icmp][type]" => "%{[pfelk_csv][20]}" }
          lowercase => [ "[pf][icmp][type]" ]
        }

        if [pf][icmp][type] == "request" or [pf][icmp][type] == "reply" {
          mutate {
            add_field => {
              "[pf][icmp][echo][id]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][echo][sequence]" => "%{[pfelk_csv][22]}"
            }
            convert => {
              "[pf][icmp][echo][id]" => "integer"
              "[pf][icmp][echo][sequence]" => "integer"
            }
          }
        } else if [pf][icmp][type] == "unreachproto" {
          mutate {
            add_field => {
              "[pf][icmp][unreachable][destination][ip]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][unreachable][protocol_id]" => "%{[pfelk_csv][22]}"
            }
            convert => { "[pf][icmp][unreachable][protocol_id]" => "integer" }
          }
        } else if [pf][icmp][type] == "unreachport" {
          mutate {
            add_field => {
              "[pf][icmp][unreachable][destination][ip]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][unreachable][protocol]" => "%{[pfelk_csv][22]}"
              "[pf][icmp][unreachable][port]" => "%{[pfelk_csv][23]}"
            }
            lowercase => [ "[pf][icmp][unreachable][protocol]" ]
            convert => { "[pf][icmp][unreachable][port]" => "integer" }
          }
        } else if [pf][icmp][type] == "needfrag" {
          mutate {
            add_field => {
              "[pf][icmp][fragmentation][destination][ip]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][fragmentation][mtu]" => "%{[pfelk_csv][22]}"
            }
            convert => { "[pf][icmp][fragmentation][mtu]" => "integer" }
          }
        } else if [pf][icmp][type] == "tstamp" {
          mutate {
            add_field => {
              "[pf][icmp][timestamp][id]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][timestamp][sequence]" => "%{[pfelk_csv][22]}"
            }
            convert => {
              "[pf][icmp][timestamp][id]" => "integer"
              "[pf][icmp][timestamp][sequence]" => "integer"
            }
          }
        } else if [pf][icmp][type] == "tstampreply" {
          mutate {
            add_field => {
              "[pf][icmp][timestamp][id]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][timestamp][sequence]" => "%{[pfelk_csv][22]}"
              "[pf][icmp][timestamp][originate]" => "%{[pfelk_csv][23]}"
              "[pf][icmp][timestamp][receive]" => "%{[pfelk_csv][24]}"
              "[pf][icmp][timestamp][transmit]" => "%{[pfelk_csv][25]}"
            }
            convert => {
              "[pf][icmp][timestamp][id]" => "integer"
              "[pf][icmp][timestamp][sequence]" => "integer"
              "[pf][icmp][timestamp][originate]" => "integer"
              "[pf][icmp][timestamp][receive]" => "integer"
              "[pf][icmp][timestamp][transmit]" => "integer"
            }
          }
        } else if [pfelk_csv][21] {
          mutate { add_field => { "[pf][icmp][description]" => "%{[pfelk_csv][21]}" } }
        }
      } else if [network][transport] == "carp" or [network][iana_number] == "112" {
        mutate {
          add_field => {
            "[pf][carp][type]" => "%{[pfelk_csv][20]}"
            "[pf][carp][ttl]" => "%{[pfelk_csv][21]}"
            "[pf][carp][vhid]" => "%{[pfelk_csv][22]}"
            "[pf][carp][version]" => "%{[pfelk_csv][23]}"
            "[pf][carp][advbase]" => "%{[pfelk_csv][24]}"
            "[pf][carp][advskew]" => "%{[pfelk_csv][25]}"
          }
          convert => {
            "[pf][carp][ttl]" => "integer"
            "[pf][carp][vhid]" => "integer"
            "[pf][carp][version]" => "integer"
            "[pf][carp][advbase]" => "integer"
            "[pf][carp][advskew]" => "integer"
          }
        }
      }
    }

    # IPv6
    if [network][type] == "6" {
      mutate {
        add_field => {
          "[pf][class]" => "%{[pfelk_csv][9]}"
          "[pf][flow]" => "%{[pfelk_csv][10]}"
          "[pf][hoplimit]" => "%{[pfelk_csv][11]}"
          "[network][transport]" => "%{[pfelk_csv][12]}"
          "[network][iana_number]" => "%{[pfelk_csv][13]}"
          "[pf][packet][length]" => "%{[pfelk_csv][14]}"
          "[source][ip]" => "%{[pfelk_csv][15]}"
          "[destination][ip]" => "%{[pfelk_csv][16]}"
        }
      }
      mutate {
        lowercase => [ "[network][transport]" ]
        convert => {
          "[pf][hoplimit]" => "integer"
          "[pf][packet][length]" => "integer"
        }
      }

      if [network][transport] == "tcp" {
        mutate {
          add_field => {
            "[source][port]" => "%{[pfelk_csv][17]}"
            "[destination][port]" => "%{[pfelk_csv][18]}"
            "[pf][data_length]" => "%{[pfelk_csv][19]}"
            "[pf][tcp][flags]" => "%{[pfelk_csv][20]}"
            "[pf][tcp][sequence_number]" => "%{[pfelk_csv][21]}"
            "[pf][tcp][ack]" => "%{[pfelk_csv][22]}"
            "[pf][tcp][window]" => "%{[pfelk_csv][23]}"
            "[pf][tcp][urg]" => "%{[pfelk_csv][24]}"
            "[pf][tcp][options]" => "%{[pfelk_csv][25]}"
          }
        }
        mutate {
          convert => {
            "[source][port]" => "integer"
            "[destination][port]" => "integer"
            "[pf][data_length]" => "integer"
            "[pf][tcp][ack]" => "integer"
            "[pf][tcp][window]" => "integer"
            "[pf][tcp][urg]" => "integer"
          }
        }
      } else if [network][transport] == "udp" {
        mutate {
          add_field => {
            "[source][port]" => "%{[pfelk_csv][17]}"
            "[destination][port]" => "%{[pfelk_csv][18]}"
            "[pf][data_length]" => "%{[pfelk_csv][19]}"
          }
        }
        mutate {
          convert => {
            "[source][port]" => "integer"
            "[destination][port]" => "integer"
            "[pf][data_length]" => "integer"
          }
        }
      } else if [network][transport] in [ "icmp", "icmp6", "icmpv6", "ipv6-icmp" ] {
        mutate {
          add_field => { "[pf][icmp][type]" => "%{[pfelk_csv][17]}" }
          lowercase => [ "[pf][icmp][type]" ]
        }

        if [pf][icmp][type] == "request" or [pf][icmp][type] == "reply" {
          mutate {
            add_field => {
              "[pf][icmp][echo][id]" => "%{[pfelk_csv][18]}"
              "[pf][icmp][echo][sequence]" => "%{[pfelk_csv][19]}"
            }
            convert => {
              "[pf][icmp][echo][id]" => "integer"
              "[pf][icmp][echo][sequence]" => "integer"
            }
          }
        } else if [pf][icmp][type] == "unreachproto" {
          mutate {
            add_field => {
              "[pf][icmp][unreachable][destination][ip]" => "%{[pfelk_csv][18]}"
              "[pf][icmp][unreachable][protocol_id]" => "%{[pfelk_csv][19]}"
            }
            convert => { "[pf][icmp][unreachable][protocol_id]" => "integer" }
          }
        } else if [pf][icmp][type] == "unreachport" {
          mutate {
            add_field => {
              "[pf][icmp][unreachable][destination][ip]" => "%{[pfelk_csv][18]}"
              "[pf][icmp][unreachable][protocol]" => "%{[pfelk_csv][19]}"
              "[pf][icmp][unreachable][port]" => "%{[pfelk_csv][20]}"
            }
            lowercase => [ "[pf][icmp][unreachable][protocol]" ]
            convert => { "[pf][icmp][unreachable][port]" => "integer" }
          }
        } else if [pf][icmp][type] == "needfrag" {
          mutate {
            add_field => {
              "[pf][icmp][fragmentation][destination][ip]" => "%{[pfelk_csv][18]}"
              "[pf][icmp][fragmentation][mtu]" => "%{[pfelk_csv][19]}"
            }
            convert => { "[pf][icmp][fragmentation][mtu]" => "integer" }
          }
        } else if [pf][icmp][type] == "tstamp" {
          mutate {
            add_field => {
              "[pf][icmp][timestamp][id]" => "%{[pfelk_csv][18]}"
              "[pf][icmp][timestamp][sequence]" => "%{[pfelk_csv][19]}"
            }
            convert => {
              "[pf][icmp][timestamp][id]" => "integer"
              "[pf][icmp][timestamp][sequence]" => "integer"
            }
          }
        } else if [pf][icmp][type] == "tstampreply" {
          mutate {
            add_field => {
              "[pf][icmp][timestamp][id]" => "%{[pfelk_csv][18]}"
              "[pf][icmp][timestamp][sequence]" => "%{[pfelk_csv][19]}"
              "[pf][icmp][timestamp][originate]" => "%{[pfelk_csv][20]}"
              "[pf][icmp][timestamp][receive]" => "%{[pfelk_csv][21]}"
              "[pf][icmp][timestamp][transmit]" => "%{[pfelk_csv][22]}"
            }
            convert => {
              "[pf][icmp][timestamp][id]" => "integer"
              "[pf][icmp][timestamp][sequence]" => "integer"
              "[pf][icmp][timestamp][originate]" => "integer"
              "[pf][icmp][timestamp][receive]" => "integer"
              "[pf][icmp][timestamp][transmit]" => "integer"
            }
          }
        } else if [pfelk_csv][18] {
          mutate { add_field => { "[pf][icmp][description]" => "%{[pfelk_csv][18]}" } }
        }
      } else if [network][transport] == "carp" or [network][iana_number] == "112" {
        mutate {
          add_field => {
            "[pf][carp][type]" => "%{[pfelk_csv][17]}"
            "[pf][carp][ttl]" => "%{[pfelk_csv][18]}"
            "[pf][carp][vhid]" => "%{[pfelk_csv][19]}"
            "[pf][carp][version]" => "%{[pfelk_csv][20]}"
            "[pf][carp][advbase]" => "%{[pfelk_csv][21]}"
            "[pf][carp][advskew]" => "%{[pfelk_csv][22]}"
          }
          convert => {
            "[pf][carp][ttl]" => "integer"
            "[pf][carp][vhid]" => "integer"
            "[pf][carp][version]" => "integer"
            "[pf][carp][advbase]" => "integer"
            "[pf][carp][advskew]" => "integer"
          }
        }
      }
    }

    # Normalize network layer.
    if [network][type] == "4" {
      mutate { update => { "[network][type]" => "ipv4" } }
    } else if [network][type] == "6" {
      mutate { update => { "[network][type]" => "ipv6" } }
    }

    # filterlog is generated by a network/perimeter observer. ECS therefore
    # recommends inbound/outbound rather than host-oriented ingress/egress.
    if [network][direction] == "in" {
      mutate {
        copy => {
          "[interface][name]" => "[observer][ingress][interface][name]"
        }
        update => {
          "[network][direction]" => "inbound"
        }
      }
    } else if [network][direction] == "out" {
      mutate {
        copy => {
          "[interface][name]" => "[observer][egress][interface][name]"
        }
        update => {
          "[network][direction]" => "outbound"
        }
      }
    }

    # A filterlog record describes one packet. Preserve the firewall-specific
    # packet/payload lengths while also providing ECS network totals.
    if [pf][packet][length] {
      mutate {
        copy => {
          "[pf][packet][length]" => "[network][bytes]"
        }
        add_field => {
          "[network][packets]" => "1"
        }
      }
      mutate {
        convert => {
          "[network][bytes]" => "integer"
          "[network][packets]" => "integer"
        }
      }
    }

    if ![source][ip] or ![destination][ip] {
      mutate {
        add_tag => [ "pfelk_pipeline_error", "_pfelk_firewall_parse_failure" ]
      }
    }
  }
}
