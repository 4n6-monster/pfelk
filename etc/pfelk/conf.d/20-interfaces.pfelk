# 20-interfaces.pfelk
################################################################################
# Version: 26.10                                                               #
# Required: False - Optional                                                   #
# Description: Example interface alias/network-name enrichment.                #
#                                                                              #
# Customize firewall hostname and interface mappings before enabling.          #
################################################################################

filter {
  if "firewall" in [tags] {
    # Example firewall. Duplicate this block for additional firewalls.
    if [log][syslog][hostname] == "first.network.local" {
      if [interface][name] == "igb0" {
        mutate {
          add_field => {
            "[interface][alias]" => "WAN"
            "[network][name]" => "Internet"
          }
        }
      } else if [interface][name] == "igb1" {
        mutate {
          add_field => {
            "[interface][alias]" => "LAN"
            "[network][name]" => "Home Network"
          }
        }
      } else if [interface][name] == "igb2" {
        mutate {
          add_field => {
            "[interface][alias]" => "DMZ"
            "[network][name]" => "DMZ"
          }
        }
      } else if [interface][name] == "lo0" {
        mutate {
          add_field => {
            "[interface][alias]" => "Loopback"
            "[network][name]" => "Loopback"
          }
        }
      }

      # Safe fallback: preserve the physical/logical interface name as alias.
      if ![interface][alias] and [interface][name] {
        mutate {
          copy => {
            "[interface][name]" => "[interface][alias]"
            "[interface][name]" => "[network][name]"
          }
        }
      }

      # Mirror the alias into the ECS observer side selected by 02-firewall.
      if [network][direction] == "inbound" and [interface][alias] {
        mutate {
          copy => {
            "[interface][alias]" => "[observer][ingress][interface][alias]"
          }
        }
      } else if [network][direction] == "outbound" and [interface][alias] {
        mutate {
          copy => {
            "[interface][alias]" => "[observer][egress][interface][alias]"
          }
        }
      }
    }
  }
}
