# openvpn.grok
################################################################################
# Version: 26.10                                                               #
# OPNsense/pfSense OpenVPN log Grok patterns for pfELK                         #
################################################################################

# OPENVPN
OPENVPN (%{OVPN_SER}|%{OVPN_ST}|%{OVPN_CLIENT}|%{OVPN_MULTI}|%{OVPN_ISQ}|%{OVPN_PH}|%{OVPN_USER})

OVPN_SER openvpn server '%{DATA:[openvpn][server][name]}' user '%{USER:[openvpn][client][user][name]}' address '%{IP:[openvpn][client][ip]}'(?::%{INT:[openvpn][client][port]:int})? - %{GREEDYDATA:[openvpn][event][original]}
OVPN_ST user '%{USER:[openvpn][client][user][name]}' %{GREEDYDATA:[openvpn][event][original]}

OVPN_CLIENT (%{OVPN_C1}|%{OVPN_C2})
OVPN_C1 %{USER:[openvpn][client][user][name]}/%{IP:[openvpn][client][ip]}:%{INT:[openvpn][client][port]:int} MULTI_sva: pool returned IPv4=(%{IP:[openvpn][source][ip]}|\(Not enabled\)), IPv6=(\(Not enabled\)|%{IP:[openvpn][source][ipv6]})
OVPN_C2 %{USER:[openvpn][client][user][name]}/%{IP:[openvpn][client][ip]}:%{INT:[openvpn][client][port]:int} MULTI: primary virtual IP for %{USER:[openvpn][client][user][name]}/%{IP:[openvpn][client][ip]}:%{INT:[openvpn][client][port]:int}: %{IP:[openvpn][source][ip]}
OVPN_MULTI %{USER:[openvpn][client][user][name]}/%{IP:[openvpn][client][ip]}:%{INT:[openvpn][client][port]:int} MULTI: Learn: %{IP:[openvpn][source][ip]} -> %{USER:[openvpn][client][user][name]}/%{IP:[openvpn][client][ip]}:%{INT:[openvpn][client][port]:int}

### OPENVPN Enhanced Log Parser ###
OVPN_ISQ Initialization Sequence Completed
OVPN_PH %{IP:[openvpn][client][ip]}:%{INT:[openvpn][client][port]:int}\s%{OVPN_PINFOI}
OVPN_PINFOI peer info: (%{OVPN_PINFO1}|%{OVPN_PINFO2}|%{OVPN_PINFO3})
OVPN_PINFO1 ((IV_COMP_STUB(v2)?=%{INT:[openvpn][client][iv][comp_stub]:int})|(IV_BS64DL=%{INT:[openvpn][client][iv][bs64dl]:int})|(IV_LZO=%{INT:[openvpn][client][iv][lzo]:int})|(IV_LZ4v2=%{INT:[openvpn][client][iv][lz4v2]:int})|(IV_LZ4=%{INT:[openvpn][client][iv][lz4]:int})|(IV_NCP=%{INT:[openvpn][client][iv][ncp]:int})|(IV_PLAT=%{WORD:[openvpn][client][platform]})|(IV_PROTO=%{INT:[openvpn][client][iv][proto]:int})|(IV_TCPNL=%{INT:[openvpn][client][iv][tcpnl]:int})|(IV_PLAT_VER=%{GREEDYDATA:[openvpn][client][platform_version]}))
OVPN_PINFO2 ((IV_VER=%{GREEDYDATA:[openvpn][client][version]})|(IV_GUI_VER=%{GREEDYDATA:[openvpn][client][gui_version]}))
OVPN_PINFO3 ((IV_SSO=%{GREEDYDATA:[openvpn][client][sso]})|(IV_CIPHERS=%{GREEDYDATA:[openvpn][client][ciphers]}))

OVPN_USER Locate overwrite for '%{USERNAME:[openvpn][client][user][name]}' using server '%{DATA:[openvpn][server][name]}' \(vpnid: %{INT:[openvpn][server][id]:int}\)
